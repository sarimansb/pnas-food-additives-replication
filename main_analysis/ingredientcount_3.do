*Remove parentheses and their content
gen cleaned_variable = new_ingredients
replace cleaned_variable = subinstr(cleaned_variable, ")", "", .)
replace  cleaned_variable = subinstr(cleaned_variable, "(", " ", .)
replace  cleaned_variable = subinstr(cleaned_variable, "(", " ", .)
replace cleaned_variable = subinstr(cleaned_variable, "{", "", .)
replace  cleaned_variable = subinstr(cleaned_variable, "}", " ", .)
replace cleaned_variable = subinstr(cleaned_variable, "[", "", .)
replace  cleaned_variable = subinstr(cleaned_variable, "]", " ", .)
replace cleaned_variable = lower(cleaned_variable)
replace cleaned_variable = subinstr(cleaned_variable, " and/or ", " and ", .)
replace cleaned_variable = subinstr(cleaned_variable, " and ", ",", .)
replace cleaned_variable = subinstr(cleaned_variable, ",and", ",", .)
replace cleaned_variable = subinstr(cleaned_variable, ", and", ",", .)
replace cleaned_variable = subinstr(cleaned_variable, ",,", ",", .)

* Preliminary ingredient count used to identify potentially mis-separated
* single-ingredient records.
gen ingredient_count = 1
replace ingredient_count = ingredient_count + (length(cleaned_variable) - length(subinstr(cleaned_variable, ",", "", .)))
replace ingredient_count = ingredient_count + (length(cleaned_variable) - length(subinstr(cleaned_variable, ";", "", .)))
replace ingredient_count = ingredient_count + (length(cleaned_variable) - length(subinstr(cleaned_variable, "&", "", .)))

*Handle cases with empty ingredients
replace ingredient_count = . if cleaned_variable == ""

*Drop the temporary cleaned column
drop cleaned_variable

*Terms appearing in the formats specified below were determined to represent separate ingredients and were therefore treated as separate ingredients in the standardized ingredient lists.
replace new_ingredients = lower(new_ingredients)
replace new_ingredients = subinstr(new_ingredients, "preserved with", ",", .)
replace new_ingredients = subinstr(new_ingredients, "as a preservative", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "as preservative", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "processed with", ",", .) 
replace new_ingredients = subinstr(new_ingredients, "colored with", ",", .) 
replace new_ingredients = subinstr(new_ingredients, "added to retain", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "added to maintain", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "added to preserve", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "treated with", ",", .)
replace new_ingredients = subinstr(new_ingredients, "roasted in", ",", .) 
replace new_ingredients = subinstr(new_ingredients, "prepared with", ",", .) 
replace new_ingredients = subinstr(new_ingredients, "vitamin d3 added", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "added as an anti", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "infused with", ",", .) 
replace new_ingredients = subinstr(new_ingredients, "diluted with", ",", .)
replace new_ingredients = subinstr(new_ingredients, "reduced with", ",", .) 
replace new_ingredients = subinstr(new_ingredients, "nitrogen-flushed", ",", .) 
replace new_ingredients = subinstr(new_ingredients, "added to packaging", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "added to the packaging", ",", .) if ingredient_count==1
replace new_ingredients = subinstr(new_ingredients, "coated with", ",", .) 

*Remove brackets (the text inside them is kept)
gen cleaned_variable2 = new_ingredients
replace cleaned_variable2 = subinstr(cleaned_variable2, ")", "", .)
replace  cleaned_variable2 = subinstr(cleaned_variable2, "(", " ", .)
replace  cleaned_variable2 = subinstr(cleaned_variable2, ":(", " ", .)
replace  cleaned_variable2 = subinstr(cleaned_variable2, ": (", " ", .)
replace  cleaned_variable2 = subinstr(cleaned_variable2, ":", " ", .)
replace  cleaned_variable2 = subinstr(cleaned_variable2, "(", " ", .)
replace cleaned_variable2 = subinstr(cleaned_variable2, "{", "", .)
replace  cleaned_variable2 = subinstr(cleaned_variable2, "}", " ", .)
replace cleaned_variable2 = subinstr(cleaned_variable2, "[", "", .)
replace  cleaned_variable2 = subinstr(cleaned_variable2, "]", " ", .)
replace cleaned_variable2 = lower(cleaned_variable2)
replace cleaned_variable2 = subinstr(cleaned_variable2, " and/or ", " and ", .)
* Protect "mono- and diglycerides" (also written "mono and", "mono-and",
* "mono & di") so this single ingredient is not split when other uses of
* "and" are converted to commas.
replace cleaned_variable2 = ustrregexra(cleaned_variable2, "mono ?-? ?(and|&) ?di", "mono_AND_HOLD di")

replace cleaned_variable2 = subinstr(cleaned_variable2, " and ", ",", .)

replace cleaned_variable2 = subinstr(cleaned_variable2, "mono_AND_HOLD", "mono and", .)
replace cleaned_variable2 = subinstr(cleaned_variable2, ",and", ",", .)
replace cleaned_variable2 = subinstr(cleaned_variable2, ", and", ",", .)
replace cleaned_variable2 = subinstr(cleaned_variable2, ",,", ",", .)

* "FD&C" and "D&C" are part of a color name, so that "&" is not a delimiter.
* \b (word boundary) keeps text such as "dried & candied" unchanged.
replace cleaned_variable2 = ustrregexra(cleaned_variable2, "\bfd ?& ?c\b", "fdc")
replace cleaned_variable2 = ustrregexra(cleaned_variable2, "\bd ?& ?c\b", "dc")

* Count occurrences of delimiters to estimate ingredient count
gen ingredient_count2 = 1
replace ingredient_count2 = ingredient_count2 + (length(cleaned_variable2) - length(subinstr(cleaned_variable2, ",", "", .)))
replace ingredient_count2 = ingredient_count2 + (length(cleaned_variable2) - length(subinstr(cleaned_variable2, ";", "", .)))
replace ingredient_count2 = ingredient_count2 + (length(cleaned_variable2) - length(subinstr(cleaned_variable2, "&", "", .)))

* Handle cases with empty ingredients
replace ingredient_count2 = . if cleaned_variable2 == ""
rename cleaned_variable2 clean_ingredients

* Keep the final ingredient count and drop the temporary variables
drop ingredient_count
rename ingredient_count2 ingredient_count
drop new_ingredients
save ".../brandedfood_3.dta", replace

